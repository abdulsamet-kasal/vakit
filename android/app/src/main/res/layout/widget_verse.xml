<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_parchment"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Üst Başlık & Sure:Ayet -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="GÜNÜN ÂYETİ"
            android:textColor="#B8934A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_verse_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Bakara, 152"
            android:textColor="#4A5C52"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Âyet Kısa Meâli (Ellipsize with maxLines 3) -->
    <TextView
        android:id="@+id/tv_verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="“Beni anın ki ben de sizi anayım; bana şükredin, nankörlük etmeyin.”"
        android:textColor="#14201A"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <!-- Alt İnce Marka Çizgisi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Vakit"
        android:textColor="#804A5C52"
        android:textSize="9sp" />

</LinearLayout>
