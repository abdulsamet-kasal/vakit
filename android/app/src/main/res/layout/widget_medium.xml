<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_medium_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_forest"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <!-- Üst Başlık & Tarih & Kerahat Rozeti -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/tv_medium_kerahat"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_medium_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="İstanbul"
                android:textColor="#F3EEE0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_medium_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bugün"
                android:textColor="#A9C4B0"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_medium_kerahat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:background="@drawable/widget_kerahat_badge_bg"
            android:paddingLeft="6dp"
            android:paddingTop="2dp"
            android:paddingRight="6dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:text="Kerahat Vakti"
            android:textColor="#C27A3E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 6 Vakit Yatay Sütunları -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. İmsak -->
        <LinearLayout
            android:id="@+id/col_imsak"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_imsak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="İmsak"
                android:textColor="#A9C4B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_imsak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#F3EEE0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/bar_imsak"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_brass_bar"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 2. Güneş -->
        <LinearLayout
            android:id="@+id/col_gunes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_gunes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Güneş"
                android:textColor="#A9C4B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_gunes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#F3EEE0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/bar_gunes"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_brass_bar"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 3. Öğle -->
        <LinearLayout
            android:id="@+id/col_ogle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_ogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Öğle"
                android:textColor="#A9C4B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_ogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#F3EEE0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/bar_ogle"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_brass_bar"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 4. İkindi -->
        <LinearLayout
            android:id="@+id/col_ikindi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_ikindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="İkindi"
                android:textColor="#A9C4B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_ikindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#F3EEE0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/bar_ikindi"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_brass_bar"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 5. Akşam -->
        <LinearLayout
            android:id="@+id/col_aksam"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_aksam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Akşam"
                android:textColor="#A9C4B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_aksam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#F3EEE0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/bar_aksam"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_brass_bar"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- 6. Yatsı -->
        <LinearLayout
            android:id="@+id/col_yatsi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbl_yatsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Yatsı"
                android:textColor="#A9C4B0"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/val_yatsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#F3EEE0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/bar_yatsi"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/widget_brass_bar"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
